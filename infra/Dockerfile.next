# Dùng chung cho apps/staff và apps/guest. Build từ gốc kho mã:
#   docker build -f infra/Dockerfile.next --build-arg APP=staff --build-arg NEXT_PUBLIC_API_URL=https://... .
# Biến NEXT_PUBLIC_* được nhúng vào bản build nên phải truyền lúc build.
ARG APP=staff

FROM node:24-alpine AS build
RUN apk add --no-cache libc6-compat
WORKDIR /repo
ARG APP
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GUEST_URL
ARG NEXT_PUBLIC_DEMO
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_GUEST_URL=$NEXT_PUBLIC_GUEST_URL \
    NEXT_PUBLIC_DEMO=$NEXT_PUBLIC_DEMO \
    BUILD_STANDALONE=1 \
    NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN npx --yes pnpm@12.14.0 install --frozen-lockfile \
 && npx --yes pnpm@12.14.0 --filter @dalan/domain --filter @dalan/contracts build \
 && npx --yes pnpm@12.14.0 --filter "@dalan/${APP}" build

FROM node:24-alpine AS runtime
ARG APP
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1 \
    APP_NAME=${APP}
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/${APP}/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build --chown=node:node /repo/apps/${APP}/public ./apps/${APP}/public
USER node
EXPOSE 3000
CMD ["sh", "-c", "node apps/${APP_NAME}/server.js"]
