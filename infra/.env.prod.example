# Sao chép thành infra/.env.prod và điền giá trị thật. KHÔNG commit tệp .env.prod.
# infra/vps/install.sh tự tạo tệp này (khóa bí mật ngẫu nhiên) nếu chưa có.
DOMAIN_API=api.dalan.com.vn
DOMAIN_STAFF=app.dalan.com.vn
DOMAIN_GUEST=menu.dalan.com.vn
ACME_EMAIL=admin@dalan.com.vn

POSTGRES_USER=dalan
POSTGRES_PASSWORD=doi-mat-khau-manh-o-day
POSTGRES_DB=dalan
BACKUP_KEEP_DAYS=14

# Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GUEST_TOKEN_SECRET=

# Mật khẩu (từ 10 ký tự) và PIN (4-6 số) cho các tài khoản nhân viên mẫu khi nạp dữ liệu lần đầu
SEED_STAFF_PASSWORD=
SEED_STAFF_PIN=

# 1 = trang đăng nhập hiện gợi ý tài khoản (bản dùng thử); 0 khi vận hành thật
NEXT_PUBLIC_DEMO=0

# Bộ chuyển đổi tích hợp: mock cho dùng thử; vận hành thật xem docs/van-hanh/can-chuan-bi-truoc-khi-van-hanh.md
PAYMENT_PROVIDERS=vietqr,mock
EINVOICE_PROVIDER=mock
MESSAGING_PROVIDER=mock
LOG_LEVEL=info
