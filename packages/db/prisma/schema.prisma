model PurchaseOrderLine {
  id          String  @id @default(uuid(7))
  poId        String
  stockItemId String
  quantity    Decimal @db.Decimal(14, 3)
  unit        String
  unitPrice   BigInt
  receivedQty Decimal @default(0) @db.Decimal(14, 3)

  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  stockItem StockItem     @relation(fields: [stockItemId], references: [id])
}

model GoodsReceipt {
  id              String   @id @default(uuid(7))
  branchId        String
  warehouseId     String
  poId            String?
  supplierId      String?
  code            String   @unique
  receivedAt      DateTime @default(now())
  invoiceNo       String?
  invoiceImageUrl String?
  total           BigInt   @default(0)
  notes           String?
  createdById     String?

  branch    Branch             @relation(fields: [branchId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  po        PurchaseOrder?     @relation(fields: [poId], references: [id])
  supplier  Supplier?          @relation(fields: [supplierId], references: [id])
  lines     GoodsReceiptLine[]
}

model GoodsReceiptLine {
  id          String    @id @default(uuid(7))
  receiptId   String
  stockItemId String
  quantity    Decimal   @db.Decimal(14, 3)
  unit        String
  unitPrice   BigInt
  lotCode     String?
  expiresAt   DateTime? @db.Date

  receipt   GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  stockItem StockItem    @relation(fields: [stockItemId], references: [id])
}

enum TransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id              String         @id @default(uuid(7))
  fromWarehouseId String
  toWarehouseId   String
  code            String         @unique
  status          TransferStatus @default(DRAFT)
  sentAt          DateTime?
  receivedAt      DateTime?
  createdById     String?
  receivedById    String?
  notes           String?
  createdAt       DateTime       @default(now())

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]
}

model StockTransferLine {
  id               String   @id @default(uuid(7))
  transferId       String
  stockItemId      String
  quantitySent     Decimal  @db.Decimal(14, 3)
  quantityReceived Decimal? @db.Decimal(14, 3)

  transfer  StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  stockItem StockItem     @relation(fields: [stockItemId], references: [id])
}

enum StocktakeStatus {
  DRAFT
  COUNTING
  REVIEW
  APPROVED
  CANCELLED
}

model Stocktake {
  id           String          @id @default(uuid(7))
  warehouseId  String
  code         String          @unique
  status       StocktakeStatus @default(DRAFT)
  startedAt    DateTime        @default(now())
  approvedAt   DateTime?
  approvedById String?
  notes        String?

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  lines     StocktakeLine[]
}

model StocktakeLine {
  id            String   @id @default(uuid(7))
  stocktakeId   String
  stockItemId   String
  expectedQty   Decimal  @db.Decimal(14, 3)
  countedQty    Decimal? @db.Decimal(14, 3)
  varianceQty   Decimal? @db.Decimal(14, 3)
  varianceValue BigInt?

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id])
}

enum StockMovementKind {
  SALE
  VOID_RETURN
  PURCHASE
  TRANSFER_OUT
  TRANSFER_IN
  STOCKTAKE_ADJ
  WASTE
  PRODUCTION_IN
  PRODUCTION_OUT
  MANUAL
}

model StockMovement {
  id          String            @id @default(uuid(7))
  warehouseId String
  stockItemId String
  kind        StockMovementKind
  quantity    Decimal           @db.Decimal(14, 4)
  unitCost    Decimal           @default(0) @db.Decimal(18, 4)
  refType     String?
  refId       String?
  reason      String?
  createdById String?
  occurredAt  DateTime          @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@index([warehouseId, stockItemId, occurredAt])
  @@index([refType, refId])
}

// ───────────────────────────── M. In ấn ─────────────────────────────

enum PrinterKind {
  RECEIPT
  KITCHEN
  LABEL
}

enum PrinterConnection {
  NETWORK
  USB
  BLUETOOTH
}

model Printer {
  id           String            @id @default(uuid(7))
  branchId     String
  code         String
  name         String
  kind         PrinterKind       @default(KITCHEN)
  connection   PrinterConnection @default(NETWORK)
  address      String?
  paperWidthMm Int               @default(80)
  isActive     Boolean           @default(true)
  lastSeenAt   DateTime?

  branch   Branch     @relation(fields: [branchId], references: [id])
  stations Station[]
  jobs     PrintJob[]

  @@unique([branchId, code])
}

enum PrintJobKind {
  KITCHEN_TICKET
  KITCHEN_VOID
  BILL_PROVISIONAL
  BILL_FINAL
  SHIFT_REPORT
  DEPOSIT_RECEIPT
  TEST
  LABEL
}

enum PrintJobStatus {
  QUEUED
  SENT
  PRINTED
  FAILED
  CANCELLED
}

model PrintJob {
  id             String         @id @default(uuid(7))
  branchId       String
  printerId      String
  kind           PrintJobKind
  payload        Json
  status         PrintJobStatus @default(QUEUED)
  attempts       Int            @default(0)
  error          String?
  refType        String?
  refId          String?
  idempotencyKey String?        @unique
  printedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id])
  printer Printer @relation(fields: [printerId], references: [id])

  @@index([branchId, status])
}

// ───────────────────────────── Hệ thống: outbox, audit, idempotency, tích hợp, báo cáo ─────────────────────────────

model DomainEvent {
  id                 String    @id @default(uuid(7))
  seq                BigInt    @default(autoincrement())
  branchId           String?
  type               String
  aggregateType      String
  aggregateId        String
  payload            Json
  actorStaffId       String?
  actorParticipantId String?
  occurredAt         DateTime  @default(now())
  publishedAt        DateTime?
  processedAt        DateTime?

  @@unique([seq])
  @@index([branchId, seq])
  @@index([aggregateType, aggregateId])
  @@index([processedAt])
}

model AuditLog {
  id               String   @id @default(uuid(7))
  orgId            String?
  branchId         String?
  actorStaffId     String?
  actorCustomerId  String?
  deviceId         String?
  action           String
  entityType       String
  entityId         String
  before           Json?
  after            Json?
  reason           String?
  ip               String?
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([entityType, entityId])
  @@index([branchId, createdAt])
  @@index([actorStaffId, createdAt])
}

model IdempotencyKey {
  key            String   @id
  scope          String
  requestHash    String
  responseStatus Int
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
}

enum IntegrationKind {
  PAYMENT
  EINVOICE
  MESSAGING
  STORAGE
}

model IntegrationConfig {
  id        String          @id @default(uuid(7))
  branchId  String?
  kind      IntegrationKind
  provider  String
  config    Json            @default("{}")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([branchId, kind, provider])
}

model DailySalesSummary {
  id           String   @id @default(uuid(7))
  branchId     String
  businessDate DateTime @db.Date
  hour         Int?
  revenue      BigInt   @default(0)
  bills        Int      @default(0)
  guests       Int      @default(0)
  sessions     Int      @default(0)
  discounts    BigInt   @default(0)
  voids        BigInt   @default(0)
  byMethod     Json     @default("{}")
  byCategory   Json     @default("{}")
  updatedAt    DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, businessDate, hour])
}
