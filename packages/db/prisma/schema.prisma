// ───────────────────────────── I. Khách hàng, tích điểm, thông báo ─────────────────────────────

model Customer {
  id               String    @id @default(uuid(7))
  orgId            String
  phone            String
  fullName         String?
  email            String?
  birthday         DateTime? @db.Date
  gender           String?
  zaloUserId       String?
