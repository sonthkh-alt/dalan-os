// DaLan OS - Prisma schema
// Quy ước: id UUID v7; tiền tệ BigInt (đồng); phần trăm là basis points (Int, 10% = 1000);
// các cột *ById là id của Staff/Customer/GuestParticipant lưu dạng chuỗi để tránh quá nhiều quan hệ.

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── A. Tổ chức, cơ sở, nhân sự ─────────────────────────────

model Organization {
  id        String   @id @default(uuid(7))
  code      String   @unique
  name      String
  legalName String?
  taxCode   String?
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches           Branch[]
  staff              Staff[]
  roles              Role[]
  menus              Menu[]
  menuItems          MenuItem[]
  modifierGroups     ModifierGroup[]
  customers          Customer[]
  loyaltyTiers       LoyaltyTier[]
  promotions         Promotion[]
  vouchers           Voucher[]
  campaigns          Campaign[]
  stockItems         StockItem[]
  suppliers          Supplier[]
  eventServiceCatalog EventServiceCatalog[]
}

enum RoundingMode {
  NONE
  TO_500
  TO_1000
}

enum QrOrderMode {
  DIRECT
  STAFF_CONFIRM
}

enum GuestJoinMode {
  OPEN
  PIN
  STAFF
}

model Branch {
  id                   String        @id @default(uuid(7))
  orgId                String
  code                 String
  name                 String
  address              String?
  phone                String?
  email                String?
  taxCode              String?
  timezone             String        @default("Asia/Ho_Chi_Minh")
  businessDayCutoff    String        @default("04:00")
  vatRateBps           Int           @default(800)
  priceIncludesVat     Boolean       @default(true)
  serviceChargeBps     Int           @default(0)
  rounding             RoundingMode  @default(NONE)
  qrOrderMode          QrOrderMode   @default(STAFF_CONFIRM)
  guestJoinMode        GuestJoinMode @default(OPEN)
  defaultDiningMinutes Int           @default(90)
  bankBin              String?
  bankAccountNo        String?
  bankAccountName      String?
  receiptHeader        String?
  receiptFooter        String?
  openingHours         Json          @default("{}")
  settings             Json          @default("{}")
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  org              Organization        @relation(fields: [orgId], references: [id])
  areas            Area[]
  tables           DiningTable[]
  stations         Station[]
  staffBranches    StaffBranch[]
  devices          Device[]
  shifts           Shift[]
  itemOverrides    BranchItemOverride[]
  menuBranches     MenuBranch[]
  sessions         TableSession[]
  orders           Order[]
  orderLines       OrderLine[]
  tickets          KitchenTicket[]
  bills            Bill[]
  payments         Payment[]
  paymentIntents   PaymentIntent[]
  eInvoices        EInvoice[]
  reservations     Reservation[]
  feedback         Feedback[]
  halls            Hall[]
  eventBookings    EventBooking[]
  warehouses       Warehouse[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  printers         Printer[]
  printJobs        PrintJob[]
  serviceRequests  ServiceRequest[]
  integrationConfigs IntegrationConfig[]
  salesSummaries   DailySalesSummary[]

  @@unique([orgId, code])
}

enum AreaKind {
  HALL
  VIP_ROOM
  OUTDOOR
  BAR
  TAKEAWAY
  VIRTUAL
}

model Area {
  id               String   @id @default(uuid(7))
  branchId         String
  code             String
  name             String
  kind             AreaKind @default(HALL)
  floor            Int?
  sortOrder        Int      @default(0)
  serviceChargeBps Int?
  minSpend         BigInt?
  layout           Json     @default("{}")
  isActive         Boolean  @default(true)

  branch       Branch        @relation(fields: [branchId], references: [id])
  tables       DiningTable[]
  reservations Reservation[]

  @@unique([branchId, code])
}

enum TableShape {
  ROUND
  RECT
  SQUARE
  BAR
}

model DiningTable {
  id            String     @id @default(uuid(7))
  branchId      String
  areaId        String
  code          String
  name          String
  minSeats      Int        @default(1)
  maxSeats      Int        @default(4)
  shape         TableShape @default(ROUND)
  posX          Int        @default(0)
  posY          Int        @default(0)
  width         Int        @default(100)
  height        Int        @default(100)
  rotation      Int        @default(0)
  isPrivateRoom Boolean    @default(false)
  minSpend      BigInt?
  qrToken       String     @unique
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  branch          Branch           @relation(fields: [branchId], references: [id])
  area            Area             @relation(fields: [areaId], references: [id])
  sessionTables   SessionTable[]
  serviceRequests ServiceRequest[]

  @@unique([branchId, code])
}

model Role {
  id          String   @id @default(uuid(7))
  orgId       String
  code        String
  name        String
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id])
  staff Staff[]

  @@unique([orgId, code])
}

model Staff {
  id                String    @id @default(uuid(7))
  orgId             String
  roleId            String
  code              String
  fullName          String
  phone             String?
  email             String?
  passwordHash      String?
  pinHash           String?
  avatarUrl         String?
  isActive          Boolean   @default(true)
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])
  branches      StaffBranch[]
  refreshTokens RefreshToken[]

  @@unique([orgId, code])
}

model StaffBranch {
  staffId   String
  branchId  String
  isDefault Boolean @default(false)

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([staffId, branchId])
}

enum DeviceKind {
  POS
  TABLET
  KDS
  PRINT_BRIDGE
  CUSTOMER_DISPLAY
}

model Device {
  id               String     @id @default(uuid(7))
  branchId         String
  name             String
  kind             DeviceKind
  tokenHash        String     @unique
  defaultStationId String?
  registeredById   String?
  lastSeenAt       DateTime?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())

  branch        Branch         @relation(fields: [branchId], references: [id])
  refreshTokens RefreshToken[]
  shifts        Shift[]
}

model RefreshToken {
  id           String    @id @default(uuid(7))
  staffId      String?
  customerId   String?
  deviceId     String?
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  device   Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([customerId])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id                 String      @id @default(uuid(7))
  branchId           String
  deviceId           String?
  openedById         String
  closedById         String?
  openedAt           DateTime    @default(now())
  closedAt           DateTime?
  openingCash        BigInt      @default(0)
  expectedCash       BigInt?
  closingCashCounted BigInt?
  variance           BigInt?
  notes              String?
  status             ShiftStatus @default(OPEN)

  branch        Branch         @relation(fields: [branchId], references: [id])
  device        Device?        @relation(fields: [deviceId], references: [id])
  cashMovements CashMovement[]
  bills         Bill[]
  payments      Payment[]

  @@index([branchId, status])
}

enum CashMovementKind {
  IN
  OUT
}

model CashMovement {
  id            String           @id @default(uuid(7))
  shiftId       String
  kind          CashMovementKind
  amount        BigInt
  reason        String
  note          String?
  attachmentUrl String?
  createdById   String
  createdAt     DateTime         @default(now())

  shift Shift @relation(fields: [shiftId], references: [id])
}

// ───────────────────────────── B. Thực đơn ─────────────────────────────

enum StationMode {
  KDS
  PRINTER
  BOTH
}

model Station {
  id        String      @id @default(uuid(7))
  branchId  String
  code      String
  name      String
  mode      StationMode @default(BOTH)
  printerId String?
  color     String?
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)

  branch  Branch          @relation(fields: [branchId], references: [id])
  printer Printer?        @relation(fields: [printerId], references: [id])
  tickets KitchenTicket[]

  @@unique([branchId, code])
}

enum MenuKind {
  ALACARTE
  BREAKFAST
  LUNCH
  SET
  BANQUET
  DRINKS
  VEGETARIAN
  OTHER
}

model Menu {
  id        String   @id @default(uuid(7))
  orgId     String
  code      String
  name      String
  nameEn    String?
  kind      MenuKind @default(ALACARTE)
  // Lịch bán: { days: [1..7], from: "06:00", to: "10:00" } hoặc {} nếu luôn bán
  schedule  Json     @default("{}")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization   @relation(fields: [orgId], references: [id])
  categories MenuCategory[]
  branches   MenuBranch[]

  @@unique([orgId, code])
}

model MenuBranch {
  menuId   String
  branchId String

  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([menuId, branchId])
}

model MenuCategory {
  id                 String   @id @default(uuid(7))
  menuId             String
  code               String
  name               String
  nameEn             String?
  imageUrl           String?
  defaultStationCode String?
  schedule           Json     @default("{}")
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@unique([menuId, code])
}

enum PricingMode {
  FIXED
  VARIANT
  WEIGHT
  MARKET
  OPEN
}

enum MenuItemStatus {
  ACTIVE
  HIDDEN
  DISCONTINUED
}

model MenuItem {
  id                 String         @id @default(uuid(7))
  orgId              String
  categoryId         String
  code               String
  name               String
  nameEn             String?
  description        String?
  descriptionEn      String?
  unit               String         @default("phần")
  pricingMode        PricingMode    @default(FIXED)
  basePrice          BigInt?
  vatRateBps         Int?
  defaultStationCode String?
  imageUrl           String?
  isVegetarian       Boolean        @default(false)
  isSignature        Boolean        @default(false)
  isSpicy            Boolean        @default(false)
  isCombo            Boolean        @default(false)
  countEmpties       Boolean        @default(false)
  ownBrand           Boolean        @default(false)
  prepMinutes        Int?
  tags               String[]       @default([])
  allergens          String[]       @default([])
  sortOrder          Int            @default(0)
  status             MenuItemStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  org             Organization            @relation(fields: [orgId], references: [id])
  category        MenuCategory            @relation(fields: [categoryId], references: [id])
  variants        MenuItemVariant[]
  modifierGroups  MenuItemModifierGroup[]
  comboComponents ComboComponent[]        @relation("ComboParent")
  overrides       BranchItemOverride[]
  priceHistory    PriceHistory[]
  recipes         Recipe[]
  orderLines      OrderLine[]
  eventMenuLines  EventMenuLine[]

  @@unique([orgId, code])
  @@index([categoryId])
}

model MenuItemVariant {
  id        String  @id @default(uuid(7))
  itemId    String
  code      String
  name      String
  nameEn    String?
  price     BigInt
  sortOrder Int     @default(0)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  item       MenuItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]

  @@unique([itemId, code])
}

model ModifierGroup {
  id         String  @id @default(uuid(7))
  orgId      String
  code       String
  name       String
  nameEn     String?
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1)
  isRequired Boolean @default(false)
  sortOrder  Int     @default(0)

  org     Organization            @relation(fields: [orgId], references: [id])
  options ModifierOption[]
  items   MenuItemModifierGroup[]

  @@unique([orgId, code])
}

model ModifierOption {
  id         String  @id @default(uuid(7))
  groupId    String
  code       String
  name       String
  nameEn     String?
  priceDelta BigInt  @default(0)
  sortOrder  Int     @default(0)
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, code])
}

model MenuItemModifierGroup {
  itemId    String
  groupId   String
  sortOrder Int    @default(0)

  item  MenuItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([itemId, groupId])
}

enum ComboComponentKind {
  FIXED
  CHOICE
}

model ComboComponent {
  id            String             @id @default(uuid(7))
  comboId       String
  name          String
  kind          ComboComponentKind @default(FIXED)
  quantity      Decimal            @default(1) @db.Decimal(10, 3)
  defaultItemId String?
  choiceItemIds String[]           @default([])
  sortOrder     Int                @default(0)

  combo MenuItem @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
}

model BranchItemOverride {
  id           String    @id @default(uuid(7))
  branchId     String
  itemId       String
  price        BigInt?
  stationCode  String?
  isAvailable  Boolean   @default(true)
  soldOutUntil DateTime?
  stockLimit   Int?
  stockLeft    Int?
  updatedAt    DateTime  @updatedAt

  branch Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item   MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([branchId, itemId])
}

model PriceHistory {
  id          String   @id @default(uuid(7))
  itemId      String
  variantId   String?
  branchId    String?
  oldPrice    BigInt?
  newPrice    BigInt?
  reason      String?
  changedById String?
  changedAt   DateTime @default(now())

  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, changedAt])
}

// ───────────────────────────── C. Phiên bàn, đơn, dòng món ─────────────────────────────

enum SessionStatus {
  PENDING
  OPEN
  BILL_REQUESTED
  CLOSED
  CANCELLED
}

enum SessionSource {
  WALK_IN
  RESERVATION
  QR
  EVENT
  TAKEAWAY
  DELIVERY
}

model TableSession {
  id             String        @id @default(uuid(7))
  branchId       String
  code           String
  status         SessionStatus @default(OPEN)
  source         SessionSource @default(WALK_IN)
  guestCount     Int           @default(0)
  businessDate   DateTime      @db.Date
  openedAt       DateTime      @default(now())
  closedAt       DateTime?
  openedById     String?
  serverId       String?
  customerId     String?
  reservationId  String?       @unique
  eventBookingId String?
  joinPin        String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch       Branch             @relation(fields: [branchId], references: [id])
  customer     Customer?          @relation(fields: [customerId], references: [id])
  reservation  Reservation?       @relation(fields: [reservationId], references: [id])
  tables       SessionTable[]
  participants GuestParticipant[]
  orders       Order[]
  orderLines   OrderLine[]
  bills        Bill[]
  requests     ServiceRequest[]
  tickets      KitchenTicket[]
  feedback     Feedback[]

  @@unique([branchId, code])
  @@index([branchId, status])
  @@index([branchId, businessDate])
}

model SessionTable {
  sessionId  String
  tableId    String
  assignedAt DateTime  @default(now())
  releasedAt DateTime?

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  table   DiningTable  @relation(fields: [tableId], references: [id])

  @@id([sessionId, tableId])
  @@index([tableId, releasedAt])
}

model GuestParticipant {
  id                String   @id @default(uuid(7))
  sessionId         String
  nickname          String?
  customerId        String?
  deviceFingerprint String?
  locale            String   @default("vi")
  isHost            Boolean  @default(false)
  joinedAt          DateTime @default(now())

  session  TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id])
}

enum OrderSource {
  STAFF
  GUEST
  PREORDER
  SYSTEM
}

enum OrderStatus {
  DRAFT
  PENDING_CONFIRM
  SENT
  CANCELLED
}

model Order {
  id                    String      @id @default(uuid(7))
  sessionId             String
  branchId              String
  seq                   Int
  source                OrderSource @default(STAFF)
  status                OrderStatus @default(DRAFT)
  placedById            String?
  placedByParticipantId String?
  confirmedById         String?
  notes                 String?
  idempotencyKey        String?     @unique
  sentAt                DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  session TableSession    @relation(fields: [sessionId], references: [id])
  branch  Branch          @relation(fields: [branchId], references: [id])
  lines   OrderLine[]
  tickets KitchenTicket[]

  @@unique([sessionId, seq])
  @@index([branchId, status])
}

enum OrderLineStatus {
  DRAFT
  SENT
  HOLD
  PREPARING
  READY
  SERVED
  VOIDED
  CANCELLED
}

model OrderLine {
  id                String          @id @default(uuid(7))
  orderId           String
  sessionId         String
  branchId          String
  itemId            String?
  variantId         String?
  nameSnapshot      String
  nameEnSnapshot    String?
  unitSnapshot      String
  unitPrice         BigInt
  quantity          Decimal         @db.Decimal(10, 3)
  expectedWeightKg  Decimal?        @db.Decimal(10, 3)
  weightKg          Decimal?        @db.Decimal(10, 3)
  modifiersSnapshot Json            @default("[]")
  modifiersTotal    BigInt          @default(0)
  lineTotal         BigInt
  vatRateBps        Int
  stationCode       String?
  course            Int             @default(1)
  status            OrderLineStatus @default(DRAFT)
  note              String?
  participantId     String?
  seatNo            Int?
  isCountedEmpties  Boolean         @default(false)
  isAdjustment      Boolean         @default(false)
  sentAt            DateTime?
  readyAt           DateTime?
  servedAt          DateTime?
  voidedAt          DateTime?
  voidReason        String?
  voidedById        String?
  voidApprovedById  String?
  wasteOnVoid       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order       Order              @relation(fields: [orderId], references: [id])
  session     TableSession       @relation(fields: [sessionId], references: [id])
  branch      Branch             @relation(fields: [branchId], references: [id])
  item        MenuItem?          @relation(fields: [itemId], references: [id])
  variant     MenuItemVariant?   @relation(fields: [variantId], references: [id])
  ticketLines KitchenTicketLine[]
  billLines   BillLine[]

  @@index([sessionId, status])
  @@index([branchId, status])
}

enum ServiceRequestKind {
  CALL_STAFF
  WATER
  UTENSILS
  BILL
  OTHER
}

enum ServiceRequestStatus {
  OPEN
  ACKED
  DONE
}

model ServiceRequest {
  id            String               @id @default(uuid(7))
  sessionId     String
  branchId      String
  tableId       String?
  participantId String?
  kind          ServiceRequestKind
  note          String?
  status        ServiceRequestStatus @default(OPEN)
  ackedById     String?
  ackedAt       DateTime?
  doneAt        DateTime?
  createdAt     DateTime             @default(now())

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  branch  Branch       @relation(fields: [branchId], references: [id])
  table   DiningTable? @relation(fields: [tableId], references: [id])

  @@index([branchId, status])
}

// ───────────────────────────── D. Bếp ─────────────────────────────

enum TicketStatus {
  NEW
  IN_PROGRESS
  DONE
  RECALLED
  VOIDED
}

model KitchenTicket {
  id          String       @id @default(uuid(7))
  branchId    String
  orderId     String
  sessionId   String
  stationId   String
  stationCode String
  seq         Int
  course      Int          @default(1)
  priority    Int          @default(0)
  status      TicketStatus @default(NEW)
  firedAt     DateTime     @default(now())
  startedAt   DateTime?
  bumpedAt    DateTime?
  printedAt   DateTime?
  printJobId  String?

  branch  Branch              @relation(fields: [branchId], references: [id])
  order   Order               @relation(fields: [orderId], references: [id])
  session TableSession        @relation(fields: [sessionId], references: [id])
  station Station             @relation(fields: [stationId], references: [id])
  lines   KitchenTicketLine[]

  @@index([branchId, stationId, status])
}

enum TicketLineStatus {
  NEW
  IN_PROGRESS
  DONE
  VOIDED
}

model KitchenTicketLine {
  id          String           @id @default(uuid(7))
  ticketId    String
  orderLineId String
  quantity    Decimal          @db.Decimal(10, 3)
  status      TicketLineStatus @default(NEW)
  startedAt   DateTime?
  doneAt      DateTime?

  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderLine OrderLine     @relation(fields: [orderLineId], references: [id])

  @@index([orderLineId])
}

// ───────────────────────────── E. Bill và thanh toán ─────────────────────────────

enum BillStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum SplitType {
  NONE
  BY_ITEM
  BY_PARTICIPANT
  EQUAL
  AMOUNT
}

model Bill {
  id                  String     @id @default(uuid(7))
  sessionId           String
  branchId            String
  shiftId             String?
  code                String
  status              BillStatus @default(OPEN)
  splitType           SplitType  @default(NONE)
  subtotal            BigInt     @default(0)
  lineDiscountTotal   BigInt     @default(0)
  billDiscountTotal   BigInt     @default(0)
  promotionTotal      BigInt     @default(0)
  serviceChargeBps    Int        @default(0)
  serviceChargeAmount BigInt     @default(0)
  vatAmount           BigInt     @default(0)
  taxBreakdown        Json       @default("[]")
  roundingAdjustment  BigInt     @default(0)
  total               BigInt     @default(0)
  paidTotal           BigInt     @default(0)
  changeGiven         BigInt     @default(0)
  printedCount        Int        @default(0)
  customerId          String?
  taxInvoiceInfo      Json?
  notes               String?
  closedAt            DateTime?
  closedById          String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  session   TableSession   @relation(fields: [sessionId], references: [id])
  branch    Branch         @relation(fields: [branchId], references: [id])
  shift     Shift?         @relation(fields: [shiftId], references: [id])
  customer  Customer?      @relation(fields: [customerId], references: [id])
  lines     BillLine[]
  discounts BillDiscount[]
  payments  Payment[]
  eInvoice  EInvoice?
  pointsTx  PointsTransaction[]
  feedback  Feedback[]

  @@unique([branchId, code])
  @@index([branchId, status])
}

model BillLine {
