# Sao chep thanh .env o thu muc goc (dev). Prisma va API deu doc tep nay.
DATABASE_URL=postgresql://dalan:dalan@127.0.0.1:5432/dalan?schema=public
REDIS_URL=redis://127.0.0.1:6379
# Khoa ky JWT (doi trong production, toi thieu 32 ky tu ngau nhien)
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
GUEST_TOKEN_SECRET=dev-guest-secret-change-me-0123456789abcdef
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
STAFF_APP_URL=http://localhost:3000
GUEST_APP_URL=http://localhost:3001
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
PAYMENT_PROVIDERS=vietqr,mock
EINVOICE_PROVIDER=mock
MESSAGING_PROVIDER=mock
# Zalo Mini App: secret key cua Zalo App (developers.zalo.me) de doi phoneToken lay so dien thoai (POST /api/v1/auth/customer/zalo)
# ZALO_APP_SECRET=
