# Địa chỉ API DaLan OS
API_URL=http://localhost:4000
# Token thiết bị loại PRINT_BRIDGE (quản lý tạo tại Quản trị > Thiết bị, hoặc POST /api/v1/auth/devices)
DEVICE_TOKEN=
# Chu kỳ kéo lệnh in khi không có realtime (ms)
POLL_INTERVAL_MS=2000
# Để trống khi dùng máy in thật; đặt thư mục để xuất PNG/ESC-POS mô phỏng
SIMULATOR_DIR=
# Cổng HTTP nội bộ: trang trạng thái và in khẩn cấp trong LAN
LOCAL_PORT=9100
# Thư mục lưu hàng đợi và cache (mặc định apps/print-bridge/data)
# DATA_DIR=C:\DaLanPrintBridge\data
# Font ưu tiên (tùy chọn): Segoe UI, Arial, Roboto...
# FONT_FAMILY=Segoe UI
PRINTER_TIMEOUT_MS=5000
PRINTER_RETRIES=3
MAX_PRINT_ATTEMPTS=10
LOG_LEVEL=info
